# Local Spring profile. Do not use prod over plain HTTP localhost because secure
# cookies enabled by the prod profile will not be returned by the browser.
SPRING_PROFILES_ACTIVE=default
PORT=8081

# Shared Omnichannel PostgreSQL database.
DB_URL=jdbc:postgresql://localhost:5432/omnichannel_pos
DB_USERNAME='FILL_DATABASE_USERNAME'
DB_PASSWORD='FILL_DATABASE_PASSWORD'

# Tenant frontend.
ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173
TENANT_LOGIN_URL=http://localhost:5173/login

# Local TikTok Shop and Lazada simulators.
MARKETPLACE_CALLBACK_BASE_URL=http://localhost:8081
# Base64 value that decodes to exactly 32 bytes. Use the same value in ChatBE.
MARKETPLACE_CREDENTIAL_ENCRYPTION_KEY='FILL_SHARED_MARKETPLACE_ENCRYPTION_KEY'

TIKTOK_BASE_URL=http://localhost:4011
TIKTOK_CLIENT_ID=omni-tiktok-local
TIKTOK_CLIENT_SECRET='FILL_TIKTOK_CLIENT_SECRET'

LAZADA_BASE_URL=http://localhost:4012
LAZADA_CLIENT_ID=omni-lazada-local
LAZADA_CLIENT_SECRET='FILL_LAZADA_CLIENT_SECRET'

MARKETPLACE_SYNC_INTERVAL_MS=30000
MARKETPLACE_SYNC_INITIAL_DELAY_MS=3000

# Cloudinary server-side credentials.
CLOUDINARY_CLOUD_NAME='FILL_CLOUDINARY_CLOUD_NAME'
CLOUDINARY_API_KEY='FILL_CLOUDINARY_API_KEY'
CLOUDINARY_API_SECRET='FILL_CLOUDINARY_API_SECRET'
CLOUDINARY_FOLDER=omnichannel-pos

# Resend SMTP.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD='FILL_RESEND_API_KEY'
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_STARTTLS_REQUIRED=true
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
STAFF_MAIL_FROM='FILL_VERIFIED_SENDER_EMAIL'

ANALYTICS_MAIL_FROM='FILL_VERIFIED_SENDER_EMAIL'
ANALYTICS_WEEKLY_EMAIL_ENABLED=true
ANALYTICS_WEEKLY_EMAIL_CRON='0 0 8 * * MON'
ANALYTICS_WEEKLY_EMAIL_ZONE=Asia/Ho_Chi_Minh

# Internal services. Shared tokens must match the target service templates.
AI_BACKEND_URL=http://localhost:8083
AI_SERVICE_TOKEN='FILL_SHARED_AI_SERVICE_TOKEN'
CHAT_BACKEND_URL=http://localhost:8082
CHAT_BACKEND_SERVICE_TOKEN='FILL_SHARED_CHAT_SERVICE_TOKEN'
